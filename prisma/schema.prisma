generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model banco {
  id      Int      @id @default(autoincrement()) @map("_id")
  capital Float
  duedate DateTime @db.Date
  logo    String
  name    String
  period  DateTime @db.Date
  tna     Float
}

model fijo {
  id      Int       @id @default(autoincrement()) @map("_id")
  capital Float     @default(0)
  client  String
  logo    String
  name    String
  period  DateTime? @db.DateTime(0)
  url     String
}

model gasto {
  id     Int      @id @default(autoincrement()) @map("_id")
  amount Float
  date   DateTime @db.Date
  detail String
  type   Int
}

model principal {
  id          Int   @id @default(autoincrement()) @map("_id")
  available   Float @default(0)
  expenses    Float @default(0)
  inbanks     Float @default(0)
  indebt      Float @default(0)
  investments Float @default(0)
  max         Float @default(0)
  monthly     Float @default(0)
  nextmonth   Float @default(0)
}

model wallet {
  id      Int      @id @default(autoincrement()) @map("_id")
  capital Float    @default(0)
  logo    String
  name    String
  period  DateTime
  tna     Float    @default(0)
}

model tipo_gasto {
  id     Int    @id @default(autoincrement()) @map("_id")
  nombre String @db.VarChar(255)
}

model inversion {
  id           Int      @id @default(autoincrement())
  nombre       String   @default("") @db.VarChar(50)
  periodo      DateTime @db.Date
  valorinicial Float    @default(0) @db.Float
  valoractual  Float    @default(0) @db.Float
  cuotapartes  Float    @default(0) @db.Float
  montoinicial Float    @default(0) @db.Float
}
