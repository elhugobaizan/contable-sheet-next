generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model banco {
  id      Int      @id @default(autoincrement()) @map("_id")
  capital Float
  duedate DateTime
  logo    String
  name    String
  period  DateTime
  tna     Float
}

model fijo {
  id      Int       @id @default(autoincrement()) @map("_id")
  capital Float     @default(0)
  client  String
  logo    String
  name    String
  period  DateTime?
  url     String
}

model gasto {
  id     Int      @id @default(autoincrement()) @map("_id")
  amount Float
  date   DateTime
  detail String
  type   Int
}

model principal {
  id          Int   @id @default(autoincrement()) @map("_id")
  available   Float @default(0)
  expenses    Float @default(0)
  inbanks     Float @default(0)
  indebt      Float @default(0)
  investments Float @default(0)
  max         Float @default(0)
  monthly     Float @default(0)
  nextmonth   Float @default(0)
}

model wallet {
  id      Int      @id @default(autoincrement()) @map("_id")
  capital Float    @default(0)
  logo    String
  name    String
  period  DateTime
  tna     Float    @default(0)
}
